# Modo da página. `prospect` (padrão) imprime os marcadores de pendência;
# `client` esconde todos eles. Ver src/components/paper.tsx.
VITE_UX_MODE=prospect

# Função serverless api/capi.ts (Meta Conversions API). Os valores reais ficam
# só nas variáveis de ambiente da Vercel, nunca aqui.
META_CAPI_ACCESS_TOKEN=
# Opcional: código de teste do Events Manager, só durante a validação.
META_TEST_EVENT_CODE=
